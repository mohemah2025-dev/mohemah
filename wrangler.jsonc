{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "workers_dev": true,
  "main": "./worker/index.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mohemah-db", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Extra origins allowed to call the API (comma separated), e.g. the Capacitor apps: capacitor://localhost,https://localhost
    "ALLOWED_ORIGINS": "capacitor://localhost,https://localhost,http://localhost"
  },
  "observability": { "enabled": true }
}
